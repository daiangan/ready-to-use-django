# Development defaults work without this file. Copy it to .env to customize them.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOW_ALL=true
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC
DJANGO_API_PAGE_SIZE=20
DJANGO_LOG_LEVEL=INFO

# Leave unset to use SQLite. Example PostgreSQL URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project

# Enable only behind a trusted reverse proxy that manages X-Forwarded-Proto.
# DJANGO_TRUST_X_FORWARDED_PROTO=true

# Optional S3 media storage in production. Prefer IAM roles over static keys.
# AWS_STORAGE_BUCKET_NAME=example-bucket
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=media.example.com
# AWS_QUERYSTRING_AUTH=true
